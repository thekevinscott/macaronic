  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^10.4.1",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "pyodide": "^314.0.8",
    "typescript": "^5.9.3"
  }
